---
import SectionHeader from "./SectionHeader.astro";
import Tags from "./Tags.astro";
import { EXPERIENCE } from "../data/experience";
import { STACK } from "../data/stack";
import { formatRange, getDictionary, localize } from "../i18n";
import type { Locale, Localized } from "../types";

interface Props {
    locale: Locale;
}

const { locale } = Astro.props;
const t = getDictionary(locale).experience;

const levels = [...EXPERIENCE].sort((a, b) => a.level - b.level);
const jobs = [...levels].reverse();
const latest = jobs[0].level;
const pad = (level: number) => String(level).padStart(2, "0");

const LOGOS = new Map(STACK.flatMap((group) => group.items).map((item) => [item.name, item.logo]));
const tagLabel = (tag: string | Localized) =>
    typeof tag === "string" ? tag : localize(tag, locale);
---

<section
    id="experience"
    aria-labelledby="experience-title"
    class="container-page py-16 mobile:py-10"
>
    <SectionHeader id="experience-title" number="02" title={t.title} subtitle={t.subtitle} />

    <div class="reveal" data-tabs>
        <div role="tablist" aria-label={t.title} class="level-map" hidden>
            {levels.map((job) => (
                <button
                    type="button"
                    role="tab"
                    id={`tab-level-${job.level}`}
                    aria-controls={`panel-level-${job.level}`}
                    aria-selected={job.level === latest ? "true" : "false"}
                    tabindex={job.level === latest ? 0 : -1}
                    class="level-node"
                >
                    <span class="level-node-box">
                        <span class="sr-only">{t.level}</span> {pad(job.level)}
                    </span>
                    <span class="level-node-label">{job.company}</span>
                </button>
            ))}
        </div>

        <div class="grid gap-10">
            {jobs.map((job) => (
                <article
                    role="tabpanel"
                    id={`panel-level-${job.level}`}
                    aria-labelledby={`tab-level-${job.level}`}
                    class="panel"
                >
                    <header class="flex flex-wrap items-start justify-between gap-4 border-b-4 border-line p-6 mobile:p-4">
                        <div>
                            <span class="mb-4 inline-block bg-accent px-2 py-1 font-pixel text-[0.6rem] text-bg">
                                {t.level} {pad(job.level)}
                            </span>
                            <h3 class="font-pixel text-[clamp(0.9rem,2vw,1.15rem)] leading-snug">
                                {job.company}
                            </h3>
                            <p class="mt-2 text-xl text-cyan mobile:text-lg">
                                {localize(job.role, locale)}
                            </p>
                        </div>
                        <p class="font-pixel text-[0.6rem] leading-6 text-ink-muted">
                            {formatRange(job.start, job.end, locale)}
                        </p>
                    </header>

                    <div class="flex flex-col gap-8 p-6 mobile:p-4">
                        {job.stages.map((stage) => (
                            <div>
                                {stage.title && (
                                    <h4 class="text-xl font-semibold text-ink mobile:text-lg">
                                        {localize(stage.title, locale)}
                                    </h4>
                                )}
                                {stage.meta && (
                                    <p class="mt-1 text-ink-muted">
                                        {localize(stage.meta, locale)}
                                    </p>
                                )}

                                {stage.mission ? (
                                    <div class="mt-5 grid gap-6">
                                        <div>
                                            <p class="level-label text-accent">{t.mission}</p>
                                            <p class="text-ink-soft">
                                                {localize(stage.mission, locale)}
                                            </p>
                                        </div>

                                        {stage.boss && (
                                            <div class="border-4 border-line bg-bg p-5 mobile:p-4">
                                                <p class="level-label text-danger">
                                                    {t.boss}: {localize(stage.boss.title, locale)}
                                                </p>
                                                <dl class="grid gap-3">
                                                    {(["before", "action", "after"] as const).map(
                                                        (key) => (
                                                            <div class="grid gap-1 sm:grid-cols-[10rem_1fr] sm:gap-4">
                                                                <dt class="font-pixel text-[0.6rem] leading-7 text-ink-muted">
                                                                    {t[key]}
                                                                </dt>
                                                                <dd class="text-ink-soft">
                                                                    {localize(
                                                                        stage.boss![key],
                                                                        locale,
                                                                    )}
                                                                </dd>
                                                            </div>
                                                        ),
                                                    )}
                                                </dl>
                                            </div>
                                        )}

                                        {stage.tags && (
                                            <div>
                                                <p class="level-label text-cyan">{t.loot}</p>
                                                <ul class="flex flex-wrap gap-2">
                                                    {stage.tags.map((tag) => {
                                                        const logo =
                                                            typeof tag === "string"
                                                                ? LOGOS.get(tag)
                                                                : undefined;
                                                        return (
                                                            <li class="chip inline-flex items-center gap-2">
                                                                {logo && (
                                                                    <svg
                                                                        class="size-4 fill-current"
                                                                        viewBox="0 0 24 24"
                                                                        aria-hidden="true"
                                                                    >
                                                                        <path d={logo.path} />
                                                                    </svg>
                                                                )}
                                                                {tagLabel(tag)}
                                                            </li>
                                                        );
                                                    })}
                                                </ul>
                                            </div>
                                        )}
                                    </div>
                                ) : (
                                    <>
                                        <ul class="pixel-list mt-4 flex flex-col gap-2 text-ink-soft">
                                            {stage.achievements?.map((item) => (
                                                <li>{localize(item, locale)}</li>
                                            ))}
                                        </ul>
                                        {stage.tags && (
                                            <div class="mt-5">
                                                <Tags items={stage.tags.map(tagLabel)} />
                                            </div>
                                        )}
                                    </>
                                )}
                            </div>
                        ))}
                    </div>
                </article>
            ))}
        </div>
    </div>
</section>

<script>
    import "../scripts/tabs";
</script>
