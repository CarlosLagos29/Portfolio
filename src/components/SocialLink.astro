---
import type { Social } from "../types";

interface Props {
    social: Social;
    color?: string;
    class?: string;
    imgClass?: string;
}

const { social, color = "FFFFFF", class: className, imgClass } = Astro.props;
const isExternal = social.href.startsWith("http");
---

<a
    href={social.href}
    target={isExternal ? "_blank" : undefined}
    rel={isExternal ? "noopener noreferrer" : undefined}
    aria-label={social.name}
    class={className}
>
    <img
        src={`https://img.icons8.com/?size=100&id=${social.icon}&format=png&color=${color}`}
        class:list={["size-full", imgClass]}
        alt={social.name}
    />
</a>
