---
interface Props {
    number: string;
    title: string;
    subtitle: string;
    id: string;
}

const { number, title, subtitle, id } = Astro.props;
---

<header class="reveal mb-10">
    <h2 id={id} class="font-pixel text-[clamp(1.1rem,3vw,1.75rem)] leading-snug">
        <span class="text-accent">{number} /</span> {title}
    </h2>
    <p class="mt-3 text-xl text-ink-muted">{subtitle}</p>
</header>
