---
import { STACK } from "../data/stack";

// La lista va duplicada para que el carrusel haga un loop continuo
const logos = [...STACK, ...STACK];
---

<div class="flex flex-col justify-center items-center">
    <h1 class="text-3xl font-bold mb-9">Mis tecnologias</h1>
    <section class="overflow-hidden w-full">
        <section class="flex animate-mobile md:animate-scroll">
            <span class="flex items-center space-x-4">
                {logos.map((tech) => (
                    <img src={tech.logo} alt={tech.name} class={tech.class ?? "size-20"} />
                ))}
            </span>
        </section>
    </section>
</div>
