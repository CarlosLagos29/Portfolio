---
import SectionHeader from "./SectionHeader.astro";
import { STACK } from "../data/stack";
import { getDictionary } from "../i18n";
import type { Locale, StackGroup } from "../types";
import { toPaths } from "../utils/pixelArt";

interface Props {
    locale: Locale;
}

const { locale } = Astro.props;
const t = getDictionary(locale).stack;

const ICONS: Record<StackGroup["id"], string[]> = {
    frontend: [
        "..........XX",
        ".........XXX",
        "........XXX.",
        ".......XXX..",
        "......XXX...",
        "..X..XXX....",
        "..XXXXX.....",
        "...XXX......",
        "...XXXX.....",
        "..XX..X.....",
        ".XX.........",
        "XX..........",
    ],
    backend: [
        "XXXXXXXXXXXX",
        "XXXXXXXXXXXX",
        "XXXXX..XXXXX",
        "XXXXX..XXXXX",
        "XX........XX",
        "XX........XX",
        "XXXXX..XXXXX",
        ".XXXX..XXXX.",
        ".XXXX..XXXX.",
        "..XXXXXXXX..",
        "...XXXXXX...",
        "....XXXX....",
    ],
    databases: [
        "............",
        ".XXXXXXXXXX.",
        "XXXXXXXXXXXX",
        "XXXXXXXXXXXX",
        ".....XX.....",
        "XXXXX..XXXXX",
        "XXXXX..XXXXX",
        "XXXXXXXXXXXX",
        "XXXXXXXXXXXX",
        "XXXXXXXXXXXX",
        "XXXXXXXXXXXX",
        "............",
    ],
    aws: [
        "............",
        "............",
        "............",
        "....XXX.....",
        "...XXXXX....",
        "..XXXXXXXXX.",
        ".XXXXXXXXXXX",
        "XXXXXXXXXXXX",
        "XXXXXXXXXXXX",
        ".XXXXXXXXXX.",
        "............",
        "............",
    ],
    web3: [
        "....XXXX....",
        "...XXXXXX...",
        "..XXXXXXXX..",
        "..XXX..XXX..",
        "..XXX..XXX..",
        "..XXX..XXX..",
        "..XXX..XXX..",
        "..XXX..XXX..",
        "..XXX..XXX..",
        "..XXXXXXXX..",
        "...XXXXXX...",
        "....XXXX....",
    ],
    tools: [
        "........X..X",
        ".......XX..X",
        ".......XXXXX",
        "......XXXXX.",
        ".....XXX....",
        "....XXX.....",
        "...XXX......",
        "..XXX.......",
        ".XXX........",
        "XXX.........",
        "XX..........",
        "............",
    ],
};

function initials(name: string) {
    const first = name.split(/[ /]/)[0];
    if (/^[A-Z0-9]{2,4}$/.test(first)) return first;
    const capitals = name.replace(/[^A-Z]/g, "");
    return capitals.length >= 2 ? capitals.slice(0, 3) : name.slice(0, 2).toUpperCase();
}

const groups = STACK.map((group) => {
    const info = t.groups[group.id];
    return {
        ...group,
        title: info.title,
        description: "description" in info ? info.description : undefined,
        icon: toPaths(ICONS[group.id], { X: "currentColor" }),
    };
});
---

<section id="stack" aria-labelledby="stack-title" class="container-page py-16 mobile:py-10">
    <SectionHeader id="stack-title" number="01" title={t.title} subtitle={t.subtitle} />

    <div class="group reveal" data-tabs>
        <div role="tablist" aria-label={t.title} class="stack-tablist mb-6" hidden>
            {groups.map((group, i) => (
                <button
                    type="button"
                    role="tab"
                    id={`tab-${group.id}`}
                    aria-controls={`panel-${group.id}`}
                    aria-selected={i === 0 ? "true" : "false"}
                    tabindex={i === 0 ? 0 : -1}
                    class="stack-tab"
                >
                    <svg class="size-6 shrink-0" viewBox="0 0 12 12" aria-hidden="true">
                        {group.icon.map((path) => (
                            <path style={`fill: ${path.fill}`} d={path.d} />
                        ))}
                    </svg>
                    {group.title}
                </button>
            ))}
        </div>

        <div class="grid gap-6">
            {groups.map((group) => (
                <article
                    role="tabpanel"
                    id={`panel-${group.id}`}
                    aria-labelledby={`tab-${group.id}`}
                    class="panel p-6 mobile:p-4"
                >
                    <h3 class="mb-4 font-pixel text-sm group-[.is-tabbed]:sr-only">
                        {group.title}
                    </h3>
                    <div class="mb-5 flex items-start justify-between gap-4 mobile:flex-col-reverse mobile:gap-2">
                        {group.description && <p class="text-ink-soft">{group.description}</p>}
                        <p class="ml-auto shrink-0 font-pixel text-[0.6rem] leading-6 text-ink-muted">
                            {t.items} <span class="text-accent">x{group.items.length}</span>
                        </p>
                    </div>
                    <ul class="stack-slots">
                        {group.items.map((item) => (
                            <li class="stack-slot">
                                <span class="stack-slot-icon" aria-hidden="true">
                                    {item.logo ? (
                                        <svg viewBox="0 0 24 24">
                                            <path d={item.logo.path} />
                                        </svg>
                                    ) : (
                                        <span class="font-pixel text-xs">
                                            {initials(item.name)}
                                        </span>
                                    )}
                                </span>
                                <span class="stack-slot-name" title={item.name}>
                                    {item.name}
                                </span>
                            </li>
                        ))}
                    </ul>
                </article>
            ))}
        </div>
    </div>
</section>

<script>
    import "../scripts/tabs";
</script>
