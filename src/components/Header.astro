---
import { getRelativeLocaleUrl } from "astro:i18n";
import { getDictionary, LOCALES } from "../i18n";
import type { Locale } from "../types";

interface Props {
    locale: Locale;
}

const { locale } = Astro.props;
const t = getDictionary(locale);
const home = getRelativeLocaleUrl(locale);

const links = [
    { href: "#stack", label: t.nav.stack },
    { href: "#experience", label: t.nav.experience },
    { href: "#projects", label: t.nav.projects },
    { href: "#contact", label: t.nav.contact },
];
---

<header class="sticky top-0 z-40 border-b-4 border-line bg-bg">
    <div class="container-page flex flex-wrap items-center justify-between gap-x-6 gap-y-2 py-3">
        <a href={home} class="flex min-h-11 items-center gap-3" aria-label={t.a11y.home}>
            <img src="/cat.gif" alt="" class="size-10 [image-rendering:pixelated]" />
            <span class="font-pixel text-[0.7rem] tracking-wide" aria-hidden="true">
                CARLOS.LAGOS
            </span>
        </a>

        <nav aria-label={t.a11y.mainNav} class="order-last w-full sm:order-none sm:w-auto">
            <ul class="flex flex-wrap items-center gap-x-1 gap-y-1">
                {links.map((link) => (
                    <li>
                        <a
                            href={link.href}
                            class="inline-flex min-h-11 items-center px-2 font-pixel text-[0.65rem] text-ink-soft uppercase hover:text-accent"
                        >
                            {link.label}
                        </a>
                    </li>
                ))}
            </ul>
        </nav>

        <div class="flex border-4 border-line" role="group" aria-label={t.a11y.language}>
            {LOCALES.map((l) => (
                <a
                    href={getRelativeLocaleUrl(l)}
                    hreflang={l}
                    lang={l}
                    data-lang-switch
                    aria-current={l === locale ? "page" : undefined}
                    class:list={[
                        "inline-grid min-h-11 min-w-11 place-items-center px-2 font-pixel text-[0.65rem] uppercase",
                        l === locale ? "bg-accent text-bg" : "text-ink-soft hover:text-accent",
                    ]}
                >
                    {l}
                </a>
            ))}
        </div>
    </div>
</header>

<script>
    // Al cambiar de idioma se conserva la sección en la que estaba el usuario
    document.querySelectorAll<HTMLAnchorElement>("[data-lang-switch]").forEach((link) => {
        link.addEventListener("click", () => {
            if (window.location.hash) link.hash = window.location.hash;
        });
    });
</script>
