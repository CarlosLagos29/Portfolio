---
import { getDictionary } from "../i18n";
import type { Locale } from "../types";

interface Props {
    locale: Locale;
}

const { locale } = Astro.props;
const t = getDictionary(locale).footer;
const year = new Date().getFullYear();
---

<footer class="mt-16 border-t-4 border-line">
    <div class="container-page flex flex-wrap items-center justify-between gap-4 py-8 font-pixel text-[0.6rem] leading-6 text-ink-muted">
        <p>
            © {year} CARLOS LAGOS · {t.location}
        </p>
        <p class="text-accent">{t.gameOver}</p>
    </div>
</footer>
