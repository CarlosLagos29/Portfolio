---
import "../styles/global.css";
import { getAbsoluteLocaleUrl } from "astro:i18n";
import { getDictionary, LOCALES } from "../i18n";
import type { Locale } from "../types";

interface Props {
    locale: Locale;
}

const { locale } = Astro.props;
const t = getDictionary(locale);
const canonical = getAbsoluteLocaleUrl(locale);
const ogImage = new URL("/og.png", Astro.site).href;
---

<!doctype html>
<html lang={locale}>
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1" />
        <title>{t.meta.title}</title>
        <meta name="description" content={t.meta.description} />
        <meta name="generator" content={Astro.generator} />
        <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
        <link rel="icon" type="image/png" sizes="64x64" href="/favicon-64.png" />
        <link rel="apple-touch-icon" href="/apple-touch-icon.png" />

        <link rel="canonical" href={canonical} />
        {LOCALES.map((l) => (
            <link rel="alternate" hreflang={l} href={getAbsoluteLocaleUrl(l)} />
        ))}
        <link rel="alternate" hreflang="x-default" href={getAbsoluteLocaleUrl("es")} />

        <meta property="og:type" content="website" />
        <meta property="og:title" content={t.meta.title} />
        <meta property="og:description" content={t.meta.description} />
        <meta property="og:url" content={canonical} />
        <meta property="og:locale" content={locale === "es" ? "es_AR" : "en_US"} />
        <meta property="og:image" content={ogImage} />
        <meta property="og:image:width" content="1200" />
        <meta property="og:image:height" content="630" />
        <meta property="og:image:alt" content={t.meta.ogAlt} />
        <meta name="twitter:card" content="summary_large_image" />

        <link rel="preconnect" href="https://fonts.googleapis.com" />
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
        <link
            rel="stylesheet"
            href="https://fonts.googleapis.com/css2?family=Pixelify+Sans:wght@400;600&family=Press+Start+2P&display=swap"
        />
    </head>
    <body class="min-h-screen text-lg leading-relaxed antialiased">
        <a
            href="#main"
            class="btn btn-primary sr-only focus:not-sr-only focus:fixed focus:top-4 focus:left-4 focus:z-50"
        >
            {t.a11y.skip}
        </a>
        <slot />
    </body>
</html>
